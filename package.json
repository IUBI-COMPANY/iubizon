{
  "name": "iubizon-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=iubizon-web",
    "dev:admin": "turbo dev --filter=iubizon-admin",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:web": "turbo lint --filter=iubizon-web",
    "type:check": "turbo type:check",
    "type:check:web": "yarn workspace iubizon-web type:check",
    "prettier:check": "yarn workspaces run prettier:check",
    "prettier:format": "yarn workspaces run prettier:format",
    "db:generate": "yarn workspace @iubizon/db generate",
    "db:migrate": "yarn workspace @iubizon/db db:migrate:dev",
    "db:push": "yarn workspace @iubizon/db db:push",
    "db:studio": "yarn workspace @iubizon/db db:studio",
    "db:seed": "yarn workspace @iubizon/db db:seed"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}