# ============================================
# IUBIZON - TEMPLATE DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env.local o .env.production y completa tus credenciales.
# ============================================

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase Client
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://user:password@host:5432/postgres"


# NIUBIZ
NIUBIZ_ENVIRONMENT=sandbox # sandbox o production
NIUBIZ_MERCHANT_ID=your-merchant-id
NIUBIZ_USER=your-niubiz-user
NIUBIZ_PASSWORD=your-niubiz-password

# Servicio de Correos Electrónicos (Resend & React Email)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="iubizon <notificaciones@iubizon.com>"

# Zona Horaria de Perú
TZ=America/Lima
NEXT_PUBLIC_TZ=America/Lima
NEXT_PUBLIC_LOCALE=es-PE
NEXT_PUBLIC_APP_URL=http://localhost:3000


