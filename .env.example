# ============================================
# IUBIZON - TEMPLATE DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env.local o .env.production y completa tus credenciales.
# ============================================

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Base de Datos PostgreSQL / Prisma
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# NIUBIZ
NIUBIZ_ENVIRONMENT=sandbox # sandbox o production
NIUBIZ_MERCHANT_ID=your-merchant-id
NIUBIZ_USER=your-niubiz-user
NIUBIZ_PASSWORD=your-niubiz-password
